@startuml
skinparam classAttributeIconSize 0
hide circle

class EasternSchedule {
  -{static} BASE: String = "https://reg-prod.ec.easternct.edu/StudentRegistrationSsb"
  -term: String
  ~cookieManager: CookieManager
  ~client: HttpClient
  --
  +EasternSchedule()
  +getTerm(): String
  -retrieveTerms(): String
  -parseTerms(content: String): ArrayList<Term>
  -parseCourses(content: String): ArrayList<Course>
  +getAvailableTerms(): ArrayList<Term>
  -postTerm(): String
  -createCacheFile(subject: String): Path
  -cacheCourses(subject: String): void
  +queryCourseBySubject(subject: String): ArrayList<Course>
}

class MainMenu {
    -schedule: EasternSchedule
    --
    +MainMenu(schedule: EasternSchedule)
    +run(): void
    -displayCoursesBySubject(subject: String): void
    -formatCourse(course: Course): String
}

class Student {
  -{static} MAX_CREDITS: int = 17
  -id: int
  -firstName: String
  -lastName: String
  -courses: ArrayList<Course>
  --
  +Student()
  +Student(id: int, firstName: String, lastName: String)
  +getId(): int
  +setId(id: int): void
  +getFirstName(): String
  +setFirstName(firstName: String): void
  +getLastName(): String
  +setLastName(lastName: String): void
  +getCourses(): ArrayList<Course>
  +setCourses(courses: ArrayList<Course>): void
  +addCourse(course: Course): boolean
  +addCourses(courses: Course[]): boolean
  +dropCourse(course: Course): boolean
  +dropCourses(courses: Course[]): boolean
  +dropAllCourses(): void
  +displayCourses(): void
}

record Course {
  -id : String
  -subject: String
  -courseNumber: String
  -meetingsFaculty: List<MeetingFaculty>
  -faculty: List<Faculty>
  -sequenceNumber: int
  -courseTitle: String
}

record Faculty {
  -displayName: String
}

record MeetingFaculty {
  -meetingTime: MeetingTime
}

record MeetingTime {
  -startTime: LocalTime
  -endTime: LocalTime
  -creditHourSession: double
  -monday: boolean
  -tuesday: boolean
  -wednesday: boolean
  -thursday: boolean
  -friday: boolean
  -saturday: boolean
  -sunday: boolean
}

record Term {
  -code: String
  -description: String
}

'Aggregation and composition
MeetingFaculty "1" o-- "1" MeetingTime : has a >
Course "1" 0-- "0*" MeetingFaculty: has a >
Course "1" 0-- "1*" Faculty: taught by >
Student "1" *-- "0*" Course : enrolls in >
MainMenu ..> EasternSchedule : queries courses by subject
MainMenu ..> Course : formats and displays
Student ..> Course : adds and drops

'Dependencies
EasternSchedule ..> Term : uses
EasternSchedule ..> Course : uses

@enduml